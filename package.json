{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chat/web dev",
    "build": "pnpm --filter @chat/web build",
    "preview": "pnpm --filter @chat/web preview",
    "android:sync": "pnpm build && npx cap sync android",
    "android:assets": "npx @capacitor/assets generate --android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
